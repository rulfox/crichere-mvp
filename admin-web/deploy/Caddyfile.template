# Generated into deploy/Caddyfile by scripts/csp.mjs (npm run build:host). Serves the static export
# with the headers docs/PHASE20.md G11 requires: CSP, X-Frame-Options DENY, HSTS, noindex.
{
	admin off
	auto_https off
}

(security) {
	header {
		Content-Security-Policy "{{CSP}}"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Robots-Tag "noindex, nofollow, noarchive"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		-Server
	}
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip

	import security

	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@html not path /_next/static/*
	header @html Cache-Control "no-cache"

	# Pages are folders with index.html (trailingSlash export); anything else is a real 404.
	try_files {path} {path}/index.html
	file_server

	handle_errors {
		import security
		rewrite * /404.html
		file_server
	}
}
