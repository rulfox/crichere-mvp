# Backend origin the admin site calls (cookies are set by that host).
NEXT_PUBLIC_API_BASE=http://localhost:8080
# Google OAuth web client for admin sign-in (public value).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=111016291164-885leerfs3tqgc4g2mkh2c4k1pn5jlrj.apps.googleusercontent.com
# Shown on the sign-in page so a local build is never mistaken for production.
NEXT_PUBLIC_ENV_LABEL=Local
