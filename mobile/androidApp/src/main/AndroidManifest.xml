<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!--
        Task 7's Profile Setup GPS auto-fill. Coarse, not fine: state/city-level precision is
        all this feature needs (see DeviceLocationProvider.android.kt), and it's requested at
        runtime just before the first "use my location" tap (ProfileSetupScreen.kt), never
        unprompted at app start.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!--
        Push notifications (docs/PHASE8.md). Required at runtime on Android 13+ (API 33),
        requested once, low-friction, after a successful login (see AppStartViewModel's post-auth
        flow); a decline is a silent no-op, no nagging, no explanation screen this phase.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CricherApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.Crichere"
        android:usesCleartextTraffic="true">
        <!--
            Cleartext (plain HTTP) traffic is required for this toolchain-proof task: the local
            dev backend serves plain http://10.0.2.2:8080, not https. Task 6+ should revisit this
            once the app talks to a deployed (TLS) backend. This flag has no bearing on that
            future change, since it only affects local development builds against the local
            backend.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Crichere">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                Deep link into a specific league (Phase 3, see docs/PHASE3.md's Decisions Made):
                crichere://leagues/{id}. No longer what Share sends (see below), but notification
                taps still open the app through it.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="crichere" android:host="leagues" />
            </intent-filter>

            <!--
                Android App Link for the shared watch link (docs/PHASE13.md):
                https://crichere.com/leagues/{id} opens the league here when the app is installed,
                and the web viewer otherwise. autoVerify checks
                https://crichere.com/.well-known/assetlinks.json against this build's signing key.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="crichere.com" />
                <data android:pathPrefix="/leagues/" />
            </intent-filter>
        </activity>

        <!--
            Ground location picker (Phase 2). ${MAPS_API_KEY} resolves via the manifest
            placeholder androidApp/build.gradle.kts sets from local.properties, blank in this
            environment (no key provisioned yet), which lets the Maps SDK initialize and degrade
            gracefully (a blank/watermarked map) rather than fail the build. See that file's
            comment for the full reasoning.
        -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}" />

        <!-- Push notifications (docs/PHASE8.md), see CrichereFirebaseMessagingService's own doc. -->
        <service
            android:name=".notification.CrichereFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>
