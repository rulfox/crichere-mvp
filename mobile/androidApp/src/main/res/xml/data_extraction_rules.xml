<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+. SecureStorage's Tink keyset is wrapped by an Android Keystore key that never leaves
    the device, so a restored keyset (or the ciphertext it protects) can't be decrypted and breaks
    sign-in. Keep both out of cloud backup and device transfer. Pre-12 equivalent: backup_rules.xml.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="crichere_secure_storage_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/crichere_secure_storage.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="crichere_secure_storage_keyset_prefs.xml" />
        <exclude domain="file" path="datastore/crichere_secure_storage.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
